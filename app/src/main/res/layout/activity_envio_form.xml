<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pantalla"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/formTitulo"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/accion_volver"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/envio_titulo_crear"
        app:titleTextColor="@color/texto"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="@string/envio_introduccion"
                android:textColor="@color/texto_secundario"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/textAvisoRetirado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_aviso"
                android:drawableStart="@drawable/ic_local_shipping"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:text="@string/envio_aviso_retirado"
                android:textColor="@color/turbo_amarillo"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:drawableTint="@color/turbo_amarillo"/>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.TortugaTurbo.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:accessibilityHeading="true"
                        android:text="@string/envio_seccion_destinatario"
                        android:drawableStart="@drawable/ic_person"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        app:drawableTint="@color/turbo_amarillo"
                        android:textColor="@color/turbo_amarillo"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDestinatario" style="@style/Widget.TortugaTurbo.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/envio_hint_destinatario"
                        app:helperText="@string/envio_helper_destinatario">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputDestinatario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLength="100"
                            android:textColor="@color/texto"
                            android:imeOptions="actionNext"
                            android:singleLine="true"
                            android:autofillHints="personName"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilTelDestinatario" style="@style/Widget.TortugaTurbo.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/envio_hint_telefono"
                        app:helperText="@string/envio_helper_telefono">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputTelDestinatario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:inputType="phone"
                            android:maxLength="15"
                            android:textColor="@color/texto"
                            android:imeOptions="actionNext"
                            android:singleLine="true"
                            android:digits="0123456789"
                            android:autofillHints="phoneNational"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.TortugaTurbo.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:accessibilityHeading="true"
                        android:text="@string/envio_seccion_paquete"
                        android:drawableStart="@drawable/ic_place"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        app:drawableTint="@color/turbo_amarillo"
                        android:textColor="@color/turbo_amarillo"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="6dp"
                        android:drawableStart="@drawable/bg_punto_ruta"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:labelFor="@+id/spinnerOrigen"
                        android:text="@string/envio_origen"
                        android:textColor="@color/texto_secundario"
                        android:textSize="14sp"
                        app:drawableTint="@color/turbo_naranja"/>
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_campo"
                        android:paddingHorizontal="4dp">
                        <Spinner
                            android:id="@id/spinnerOrigen"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:backgroundTint="@color/turbo_naranja"
                            android:dropDownVerticalOffset="8dp"
                            android:popupBackground="@drawable/bg_campo"
                            android:spinnerMode="dropdown"
                            android:prompt="@string/envio_origen"/>
                    </FrameLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="6dp"
                        android:drawableStart="@drawable/bg_punto_ruta"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:labelFor="@+id/spinnerDestino"
                        android:text="@string/envio_destino"
                        android:textColor="@color/texto_secundario"
                        android:textSize="14sp"
                        app:drawableTint="@color/tortuga_verde"/>
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_campo"
                        android:paddingHorizontal="4dp">
                        <Spinner
                            android:id="@id/spinnerDestino"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:backgroundTint="@color/turbo_naranja"
                            android:dropDownVerticalOffset="8dp"
                            android:popupBackground="@drawable/bg_campo"
                            android:spinnerMode="dropdown"
                            android:prompt="@string/envio_destino"/>
                    </FrameLayout>
                    <TextView
                        android:id="@+id/textErrorDestino"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/error_envio_destino"
                        android:textColor="?attr/colorError"
                        android:textSize="12sp"
                        android:visibility="gone" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDireccion" style="@style/Widget.TortugaTurbo.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/envio_hint_direccion"
                        app:helperText="@string/envio_helper_direccion">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputDireccion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:inputType="textPostalAddress|textCapWords"
                            android:maxLength="200"
                            android:textColor="@color/texto"
                            android:imeOptions="actionNext"
                            android:singleLine="true"
                            android:autofillHints="postalAddress"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPeso" style="@style/Widget.TortugaTurbo.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/envio_hint_peso"
                        app:helperText="@string/envio_helper_peso">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputPeso"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:inputType="numberDecimal"
                            android:maxLength="5"
                            android:textColor="@color/texto"
                            android:imeOptions="actionNext"
                            android:singleLine="true"
                            android:digits="0123456789.,"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:labelFor="@+id/radioServicio"
                        android:text="@string/envio_servicio"
                        android:textColor="@color/texto_secundario"
                        android:textSize="14sp"/>
                    <RadioGroup
                        android:id="@id/radioServicio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:checkedButton="@+id/radioEstandar"
                        android:orientation="horizontal">
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@id/radioEstandar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_opcion"
                            android:button="@null"
                            android:drawableTop="@drawable/ic_local_shipping"
                            android:drawablePadding="6dp"
                            android:gravity="center"
                            android:minHeight="88dp"
                            android:paddingVertical="14dp"
                            android:text="@string/servicio_estandar"
                            android:textColor="@color/chip_filtro_texto"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:buttonTint="@android:color/transparent"
                            app:drawableTint="@color/opcion_icono"/>
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioExpress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_opcion"
                            android:button="@null"
                            android:drawableTop="@drawable/ic_bolt"
                            android:drawablePadding="6dp"
                            android:gravity="center"
                            android:minHeight="88dp"
                            android:paddingVertical="14dp"
                            android:text="@string/servicio_express"
                            android:textColor="@color/chip_filtro_texto"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:buttonTint="@android:color/transparent"
                            app:drawableTint="@color/opcion_icono"/>
                    </RadioGroup>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDescripcion" style="@style/Widget.TortugaTurbo.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/envio_hint_descripcion"
                        app:helperText="@string/envio_helper_descripcion">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputDescripcion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLength="100"
                            android:textColor="@color/texto"
                            android:imeOptions="actionDone"
                            android:minLines="3"
                            android:gravity="top|start"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_estimacion"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:drawableStart="@drawable/ic_inventory"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical"
                    android:text="@string/envio_seccion_estimacion"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:drawableTint="@color/white"/>
                <TextView
                    android:id="@+id/textAyudaEstimacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/envio_helper_estimacion"
                    android:textColor="#E6FFFFFF"
                    android:textSize="14sp"/>
                <LinearLayout
                    android:id="@+id/textPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:accessibilityLiveRegion="polite"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/textKm"
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:maxLines="1"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="22sp"
                            app:autoSizeMinTextSize="14sp"
                            app:autoSizeTextType="uniform"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/envio_dato_distancia"
                            android:textColor="#CCFFFFFF"
                            android:textSize="13sp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/textPrecio"
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:maxLines="1"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="22sp"
                            app:autoSizeMinTextSize="14sp"
                            app:autoSizeTextType="uniform"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/envio_dato_precio"
                            android:textColor="#CCFFFFFF"
                            android:textSize="13sp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/textDias"
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:maxLines="1"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="22sp"
                            app:autoSizeMinTextSize="14sp"
                            app:autoSizeTextType="uniform"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/envio_dato_entrega"
                            android:textColor="#CCFFFFFF"
                            android:textSize="13sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonGuardar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/turbo_naranja"
                android:text="@string/envio_crear"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_check_circle"
                app:iconGravity="textStart"
                app:iconTint="@color/white"/>
            <ProgressBar
                android:id="@+id/progreso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
